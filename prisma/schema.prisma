generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Clientes {
  id Int @id @default(autoincrement())
  nome String @db.VarChar(255)
  dataNascimento DateTime @db.Date
  genero String @db.Char(10)
  codigo String @db.Char(6)
  email String @db.VarChar(50)
  cpf String @db.VarChar(15)
  senha String @db.VarChar(255)
  status Boolean @default(true)

  Enderecos Enderecos[]
}

model Paises {
  id Int @id @default(autoincrement())
  nome String @db.VarChar(50)
  codigo String @db.Char(4)
  estados Estados[]

  Enderecos Enderecos[]
}

model Estados {
  id Int @id @default(autoincrement())
  nome String @db.VarChar(50)
  codigo String @db.Char(2)
  pais Paises @relation(fields: [paisId], references: [id])
  paisId Int
  cidades Cidades[]

  Enderecos Enderecos[]
}

model Cidades {
  id Int @id @default(autoincrement())
  nome String @db.VarChar(50)
  estados Estados @relation(fields: [estadoId], references: [id])
  estadoId Int

  Enderecos Enderecos[]
}

model Enderecos {
  id              Int        @id @default(autoincrement())
  logradouro      String     @db.VarChar(255)
  tipoLogradouro  String     @db.Char(7)
  numero          Int
  bairro          String     @db.VarChar(50)
  cep             String     @db.VarChar(9)
  complemento     String?    @db.VarChar(255)
  observacoes     String?    @db.VarChar(255)

  paisId          Int
  estadoId        Int
  cidadeId        Int
  clienteId       Int

  pais            Paises     @relation(fields: [paisId], references: [id])
  estado          Estados    @relation(fields: [estadoId], references: [id])
  cidade          Cidades    @relation(fields: [cidadeId], references: [id])
  cliente         Clientes   @relation(fields: [clienteId], references: [id])

  @@index([paisId])
  @@index([estadoId])
  @@index([cidadeId])
  @@index([clienteId])
}