generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Clientes {
  id Int @id @default(autoincrement())
  nome String @db.VarChar(255)
  dataNascimento DateTime @db.Date
  genero String @db.Char(10)
  codigo String @db.Char(6)
  email String @db.VarChar(50)
  cpf String @db.VarChar(15)
  telefone String @default("Não informado")
  senha String @db.VarChar(255)
  status Boolean @default(true)

  enderecos Enderecos[]
  cartoes CartoesCredito[]
}

model Paises {
  id        Int         @id @default(autoincrement())
  nome      String      @db.VarChar(50)
  codigo    String?     @db.Char(4)
  estados   Estados[]

  enderecos Enderecos[]

  @@unique([codigo], name: "codigo_unique")
}


model Estados {
  id        Int         @id @default(autoincrement())
  nome      String      @db.VarChar(50)
  codigo    String      @db.Char(2)
  pais      Paises      @relation(fields: [paisId], references: [id])
  paisId    Int
  cidades   Cidades[]

  enderecos Enderecos[]

  @@unique([codigo, paisId], name: "codigo_paisId")
}

model Cidades {
  id        Int         @id @default(autoincrement())
  nome      String      @db.VarChar(50)
  estado    Estados     @relation(fields: [estadoId], references: [id])
  estadoId  Int

  enderecos Enderecos[]

  @@unique([nome, estadoId], name: "nome_estadoId")
}

model Enderecos {
  id               Int        @id @default(autoincrement())
  logradouro       String     @db.VarChar(255)
  tipoLogradouro   String     @db.Char(7)
  numero           Int
  bairro           String     @db.VarChar(50)
  cep              String     @db.VarChar(9)
  complemento      String?    @db.VarChar(255)
  observacoes      String?    @db.VarChar(255)
  eEnderecoEntrega Boolean    @db.Boolean

  paisId          Int
  estadoId        Int
  cidadeId        Int
  clienteId       Int

  pais            Paises     @relation(fields: [paisId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  estado          Estados    @relation(fields: [estadoId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  cidade          Cidades    @relation(fields: [cidadeId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  cliente         Clientes   @relation(fields: [clienteId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@index([paisId])
  @@index([estadoId])
  @@index([cidadeId])
  @@index([clienteId])
}

model CartoesCredito {
  id        Int      @id @default(autoincrement())
  nome      String   @db.VarChar(50)
  numero    String   @db.VarChar(16)
  bandeira  String   @db.VarChar(16)
  validade  String   @db.VarChar(7)
  cvv       String   @db.Char(3)
  isMain    Boolean  @db.Boolean

  client   Clientes @relation(fields: [clienteId], references: [id])
  clienteId Int
}