<!doctype html>
<html lang="pt-br">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <link rel="stylesheet" href="/css/index.css" type="text/css">
    <link rel="stylesheet" href="/css/cadastro/cadastro.css" type="text/css">
    <link rel="stylesheet" href="/css/header/header.css" type="text/css">
    <title>Registrar</title>
</head>
<body>
<header class="main-header">
    <nav class="navbar">
        <div class="logo">
            <a href="/">Cliente</a>
        </div>
        <ul class="nav-links">
            <li><a href="/cliente/cadastro">Cadastro</a></li>
            <li><a href="/cliente/consulta">Consulta</a></li>
        </ul>
    </nav>
</header>
<div class="container">
    <div class="progress">
        <div class="logo"></div>
        <div class="steps-container">
        </div>
    </div>
    <form id="register-form" action="/cliente/cadastro" method="post">
        <div class="container-form">
            <div id="form-one" class="form-one form-step">
                <div class="form-information">
                    <h3>Informações Pessoais</h3>
                    <p>Por favor, preencha suas informações pessoais nos campos abaixo.</p>
                </div>

                <div class="container-input">
                    <div class="input">
                        <label class="input-label">Nome completo:</label>
                        <%- include('./../components/input/input', {
                            placeHolder: "Nome completo*",
                            type: "text",
                            name: "nome",
                            id: "nome-input",
                            value: ""
                        }) %>
                    </div>

                    <div class="input">
                        <label class="input-label">CPF:</label>
                        <%- include('./../components/input/input', {
                        placeHolder: "123.456.789-10*",
                        type: "text",
                        name: "cpf",
                        id: "cpf-input",
                        value: ""
                        }) %>
                    </div>

                    <div class="input">
                        <label class="input-label">Telefone:</label>
                        <%- include('./../components/input/input', {
                        placeHolder: "(11) 91234-5678",
                        type: "text",
                        name: "telefone",
                        id: "telefone-input",
                        value: ""
                        }) %>
                    </div>

                    <div class="input">
                        <label class="input-label">Tipo do telefone</label>
                        <%- include('./../components/selectInput/selectInput', {
                        name: 'tipoTelefone',
                        id: 'tipoTelefone',
                        disabled: false,
                        options: [
                            { value: '', label: 'Selecione', selected: true, disabled: true },
                            { value: 'CELULAR', label: 'Celular' },
                            { value: 'FIXO', label: 'Fixo' },
                        ]
                        }) %>
                    </div>

                    <div class="input">
                        <label class="input-label">Data de nascimento:</label>
                        <%- include('./../components/input/input', {
                            placeHolder: "dd/mm/aaaa",
                            type: "text",
                            name: "dataNascimento",
                            id: "data-nascimento-input",
                            value: ""
                        }) %>
                    </div>

                    <div class="input">
                        <label class="input-label">Gênero</label>
                        <%- include('./../components/selectInput/selectInput', {
                        name: 'genero',
                        id: 'genero',
                        disabled: false,
                        options: [
                        { value: '', label: 'Selecione', selected: true, disabled: true },
                        { value: 'MASCULINO', label: 'Masculino' },
                        { value: 'FEMININO', label: 'Feminino' },
                        { value: 'OUTRO', label: 'Outro' }
                        ]
                        }) %>
                    </div>
                </div>
            </div>

            <div id="form-two" class="form-two form-step">
                <div class="form-information">
                    <h3>Informações de Endereço</h3>
                    <p>Por favor, forneça os dados do seu endereço nos campos abaixo.</p>
                </div>

                <div class="end-container">
                    <div class="input">
                        <label class="input-label">Logradouro:</label>
                        <%- include('./../components/input/input', {
                        placeHolder: "Ex: Rua Antônio Batista",
                        type: "text",
                        name: "logradouro",
                        id: "logradouro-end-input",
                        value: ""
                        })%>
                    </div>
                    <div class="input">
                        <label class="input-label">Tipo de logradouro:</label>
                        <%- include('./../components/selectInput/selectInput', {
                        name: 'tipoLogradouro',
                        id: 'tipo-logradouro',
                        disabled: false,
                        options: [
                        { value: '', label: 'Selecione', selected: true, disabled: true },
                        { value: 'AVENIDA', label: 'Avenida' },
                        { value: 'RUA', label: 'Rua' },
                        ]
                        }) %>
                    </div>

                    <div class="input">
                        <label class="input-label">Bairro:</label>
                        <%- include('./../components/input/input', {
                        placeHolder: "Ex: Mogilar",
                        type: "text",
                        name: "bairro",
                        id: "bairro-end-input",
                        value: ""
                        }) %>
                    </div>

                    <div class="input">
                        <label class="input-label">Complemento:</label>
                        <%- include('./../components/input/input', {
                        placeHolder: "",
                        type: "text",
                        name: "complemento",
                        id: "complemento-end-input",
                        value: ""
                        }) %>
                    </div>

                    <div class="input">
                        <label class="input-label">Número:</label>
                        <%- include('./../components/input/input', {
                        placeHolder: "Ex: 100",
                        type: "number",
                        name: "numero",
                        id: "numero-end-input",
                        value: ""
                        }) %>
                    </div>

                    <div class="input">
                        <label class="input-label">CEP:</label>
                        <%- include('./../components/input/input', {
                        placeHolder: "00000-000",
                        type: "text",
                        name: "cep",
                        id: "cep-end-input",
                        value: ""
                        }) %>
                    </div>

                    <div class="input">
                        <label class="input-label">País:</label>
                        <%- include('./../components/selectInput/selectInput', {
                        name: 'pais',
                        id: 'pais',
                        disabled: false,
                        options: [
                            { value: '', label: 'Selecione', selected: true, disabled: false }
                        ]
                        }) %>
                    </div>

                    <div class="input">
                        <label class="input-label">Estado:</label>
                        <%- include('./../components/selectInput/selectInput', {
                        name: 'estado',
                        id: 'estado',
                        disabled: false,
                        options: [
                        { value: '', label: 'Selecione', selected: true, disabled: false }
                        ]
                        }) %>
                    </div>

                    <div class="input">
                        <label class="input-label">Cidade:</label>
                        <%- include('./../components/selectInput/selectInput', {
                        name: 'cidade',
                        id: 'cidade',
                        disabled: false,
                        options: [
                        { value: '', label: 'Selecione', selected: true, disabled: false }
                        ]
                        }) %>
                    </div>

                    <div style="display: flex; flex-direction: row; justify-content: center; align-items: center;" class="input">
                        <input type="checkbox" id="eEnderecoEntrega" name="eEnderecoEntrega" value="true"/>
                        <label for="scales">É endereço de entrega?</label>
                    </div>

                </div>
                <div class="input">
                    <label class="input-label">Observações:</label>
                    <%- include('./../components/textArea/textArea', {
                    placeHolder: "Digite aqui suas observações...",
                    name: "observacoes",
                    id: "observacoes-end-input",
                    value: ""
                    }) %>
                </div>
            </div>

            <div id="form-three" style="display: none" class="form-three form-step">
                <div class="form-information">
                    <h3>Informações do Cartão de Crédito</h3>
                    <p>Por favor, cadastre um cartão de crédito válido</p>
                </div>

                <div class="container-input">
                    <div class="input">
                        <label class="input-label">Número do cartão:</label>
                        <%- include('./../components/input/input', {
                        placeHolder: "0000 0000 0000 0000*",
                        type: "text",
                        name: "numeroCartao",
                        id: "numero-cartao-input",
                        value: ""
                        }) %>
                    </div>
                    <div class="input">
                        <label class="input-label">Nome do Titular:</label>
                        <%- include('./../components/input/input', {
                        placeHolder: "Nome do titular*",
                        type: "text",
                        name: "nomeImpresso",
                        id: "numero-cartao-input",
                        value: ""
                        }) %>
                    </div>
                    <div class="input">
                        <label class="input-label">Bandeira do Cartão:</label>
                        <%- include('./../components/selectInput/selectInput', {
                        name: 'bandeira',
                        id: 'bandeira',
                        disabled: false,
                        options: [
                            { value: '', label: 'Selecione', selected: true, disabled: true },
                            { value: 'Visa', label: 'Visa', selected: true, disabled: false },
                            { value: 'Mastercard', label: 'Mastercard', selected: true, disabled: false },
                            { value: 'American express', label: 'American Express', selected: true, disabled: false },
                            { value: 'Elo', label: 'Elo', selected: true, disabled: false },
                            { value: 'Hipercard', label: 'Hipercard', selected: true, disabled: false }
                        ]
                        }) %>
                    </div>
                    <div class="input">
                        <label class="input-label">Validade:</label>
                        <%- include('./../components/input/input', {
                            placeHolder: "MM/AA*",
                            type: "text",
                            name: "validade",
                            id: "validade-cartao-input",
                        value: ""
                        }) %>
                    </div>
                    <div class="input">
                        <label class="input-label">CVV:</label>
                        <%- include('./../components/input/input', {
                            placeHolder: "000*",
                            type: "text",
                            name: "cvv",
                            id: "cvv-cartao-input",
                        value: ""
                        }) %>
                    </div>
                </div>
            </div>

            <div id="form-fours" style="display: none" class="form-fours form-step">
                <div class="form-information">
                    <h3>Informações de Segurança</h3>
                    <p>Por favor, crie suas credenciais de acesso nos campos abaixo.</p>
                </div>

                <div class="container-input">
                    <div class="input">
                        <label class="input-label">Email:</label>
                        <%- include('./../components/input/input', {
                        placeHolder: "exemplo@dominio.com.br*",
                        type: "text",
                        name: "email",
                        id: "email-input",
                        value: ""
                        }) %>
                    </div>

                    <div class="input">
                        <label class="input-label">Senha:</label>
                        <%- include('./../components/passwordInput/passwordInput', {
                        placeHolder: "Senha*",
                        name: "senha",
                        id: "senha-input"
                        }) %>
                    </div>

                    <div class="input">
                        <label class="input-label">Confirmar senha:</label>
                        <%- include('./../components/passwordInput/passwordInput', {
                        placeHolder: "Confirmar senha*",
                        name: "confirmarSenha",
                        id: "confirmar-senha-input"
                        }) %>
                    </div>
                </div>
            </div>

            <div class="container-button">
                <div id="container-btn-prev">
                    <%- include('./../components/button/button', {
                    type: "button",
                    id: "btn-prev",
                    style: "second-button default-button",
                    disable: "disable",
                    textContent: "Voltar"
                    })%>
                </div>
                <div id="container-btn-next">
                    <%- include('./../components/button/button', {
                    type: "button",
                    id: "btn-next",
                    style: "primary-button default-button",
                    disable: "disable",
                    textContent: "Próximo"
                    })%>
                </div>
                <div id="container-btn-submit">
                    <%- include('./../components/button/button', {
                    type: "submit",
                    id: "btn-submit",
                    style: "primary-button default-button",
                    disable: "",
                    textContent: "Cadastrar"
                    })%>
                </div>
            </div>

        </div>
    </form>
</div>
</body>
<script src="/js/eventListeners/form/stepEventListenner.js"></script>
<script src="https://cdn.jsdelivr.net/npm/axios/dist/axios.min.js"></script>
<script type="module" src="/js/main.js"></script>
</html>
